# ── LiveKit Agent Embed Widget (public) ──────────────────────────────────────
# Agent id from LiveKit Cloud → Agents → your agent → Embed (CA_...).
NEXT_PUBLIC_LIVEKIT_EMBED_AGENT_ID=CA_your_agent_id_here

# ── Lead webhook (LiveKit Call ending → Data collection endpoint) ────────────
# URL: https://www.connectxeo.com/api/leads
# Header: Authorization: Bearer <LEADS_WEBHOOK_SECRET>
LEADS_WEBHOOK_SECRET=generate-a-long-random-string

# Source of truth: Google Sheet (share sheet with the service account email)
LEADS_GOOGLE_SHEET_ID=
LEADS_GOOGLE_SHEET_RANGE=Leads!A:Y
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# PEM private key; in Vercel use real newlines or \n escaped
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Optional: extra notify webhook (Zapier/Make/Slack bridge)
# LEADS_NOTIFY_WEBHOOK_URL=

# ── Embed checklist ──────────────────────────────────────────────────────────
# LiveKit → Embed → origins https://www.connectxeo.com + https://connectxeo.com
# Embed ON → Save → set NEXT_PUBLIC_LIVEKIT_EMBED_AGENT_ID on Vercel
