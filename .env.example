# ── LiveKit Voice API ─────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in real values.
# ALL vars are server-side only — no NEXT_PUBLIC_ prefix.
# NEVER commit .env.local to git.

# LiveKit project credentials (from LiveKit Cloud dashboard)
LIVEKIT_API_KEY=your-api-key-here
LIVEKIT_API_SECRET=your-api-secret-here
LIVEKIT_URL=wss://your-livekit-subdomain.livekit.cloud

# Room name the client connects to (default: hermes-public)
LIVEKIT_ROOM=hermes-public

# ── Voice access control ──────────────────────────────────────────────────────
# public_demo  → no auth required (open demo)
# admin_only   → caller must send X-Voice-Admin-Secret header
VOICE_ACCESS=public_demo

# Required when VOICE_ACCESS=admin_only
# VOICE_ADMIN_SECRET=change-me-strong-random-secret
