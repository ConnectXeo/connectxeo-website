# ── LiveKit Agent Embed Widget (public) ──────────────────────────────────────
# Agent id from LiveKit Cloud → Agents → your agent → Embed (looks like CA_...).
# NOT the dispatch name (connectxeo_lead_collection).
NEXT_PUBLIC_LIVEKIT_EMBED_AGENT_ID=CA_your_agent_id_here

# Optional branding is hard-coded in components/LiveKitEmbed.tsx
# (color #5e6ad2, dark theme).

# ── Dashboard checklist ──────────────────────────────────────────────────────
# 1. LiveKit Cloud → agent → Embed → Allowed origins:
#      https://www.connectxeo.com
#      https://connectxeo.com
# 2. Toggle Embed widget ON → Save
# 3. Set NEXT_PUBLIC_LIVEKIT_EMBED_AGENT_ID on Vercel → Redeploy
