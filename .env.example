# LiveKit embed
NEXT_PUBLIC_LIVEKIT_EMBED_AGENT_ID=CA_your_agent_id_here

# Lead webhook (LiveKit Call ending)
# URL: https://www.connectxeo.com/api/leads
# Header: Authorization: Bearer <LEADS_WEBHOOK_SECRET>
LEADS_WEBHOOK_SECRET=generate-a-long-random-string

# VPS Composio → Google Sheets bridge (no service account)
# Example: http://YOUR_VPS_IP:8799/leads
LEADS_BRIDGE_URL=http://2.28.71.50:8799/leads

# Admin panel (/admin) — required to create & manage blog posts
ADMIN_PASSWORD=choose-a-strong-password
# Secret used to sign the admin session cookie (use a long random string)
ADMIN_SECRET=generate-a-long-random-string
