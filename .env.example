# ── LiveKit (server-only — never NEXT_PUBLIC_) ───────────────────────────────
# Copy to .env.local and fill real values. Never commit .env.local.

LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret
LIVEKIT_URL=wss://connectxeo-fwni0inw.livekit.cloud

# Agent Builder dispatch name (exact agent_name from LiveKit Cloud Agents)
LIVEKIT_AGENT_NAME=your-agent-dispatch-name

# public_demo = contact page open to visitors
# admin_only  = requires X-Voice-Admin-Secret header
VOICE_ACCESS=public_demo

# Only if VOICE_ACCESS=admin_only
# VOICE_ADMIN_SECRET=change-me
